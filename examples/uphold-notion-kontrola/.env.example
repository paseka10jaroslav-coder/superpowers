# Uphold OAuth2 credentials
# Create a Personal Access Token at https://uphold.com/dashboard/profile/api-keys
UPHOLD_CLIENT_ID=your_uphold_client_id
UPHOLD_CLIENT_SECRET=your_uphold_client_secret

# Notion integration secret
# Create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID
# From the database URL: https://notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
